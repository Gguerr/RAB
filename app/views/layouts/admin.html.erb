<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "RAB - Panel Administrativo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag asset_path("logo_Rab.png"), type: "image/png" %>
    <link rel="apple-touch-icon" href="<%= asset_path("logo_Rab.png") %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 font-sans antialiased">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-white shadow-xl border-r-2 border-wine-primary flex flex-col" style="border-color: rgba(114, 47, 55, 0.2);">
        <!-- Sidebar Header -->
        <div class="p-4 border-b-2 flex flex-col" style="border-color: rgba(114, 47, 55, 0.2); background: linear-gradient(to right, rgba(114, 47, 55, 0.05), rgba(139, 58, 58, 0.05));">
          <div class="text-center">
            <%= image_tag "logo_Rab.png", alt: "RAB Logo", class: "w-12 h-auto rounded-lg mx-auto mb-2 shadow-md" %>
            <h2 class="text-lg font-bold tracking-wide" style="color: #722F37;">RAB Admin</h2>
            <p class="text-xs mt-0.5 uppercase tracking-wider font-medium" style="color: rgba(139, 58, 58, 0.7);">Panel Administrativo</p>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 py-4 overflow-y-auto">
          <%= link_to admin_root_path, class: "flex items-center px-6 py-3 mx-2 my-1 rounded-lg transition-all duration-200 #{'text-white shadow-md font-semibold' if current_page?(admin_root_path)} #{'text-gray-700 hover:bg-wine-primary/10 hover:text-wine-primary' unless current_page?(admin_root_path)}", style: "#{'background-color: #722F37;' if current_page?(admin_root_path)}" do %>
            <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            <span>Inicio</span>
          <% end %>

          <!-- Management Section -->
          <div class="mt-6">
            <h3 class="px-6 py-2 text-xs font-bold uppercase tracking-wider" style="color: rgba(114, 47, 55, 0.7);">Gestión</h3>
            
            <%= link_to admin_employees_path, class: "flex items-center px-6 py-3 mx-2 my-1 rounded-lg transition-all duration-200 #{'text-white shadow-md font-semibold' if controller_name == 'employees'} #{'text-gray-700 hover:bg-wine-primary/10 hover:text-wine-primary' unless controller_name == 'employees'}", style: "#{'background-color: #722F37;' if controller_name == 'employees'}" do %>
              <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <span>Empleados</span>
            <% end %>
            
            <%= link_to admin_vacations_path, class: "flex items-center px-6 py-3 mx-2 my-1 rounded-lg transition-all duration-200 #{'text-white shadow-md font-semibold' if controller_name == 'vacations'} #{'text-gray-700 hover:bg-wine-primary/10 hover:text-wine-primary' unless controller_name == 'vacations'}", style: "#{'background-color: #722F37;' if controller_name == 'vacations'}" do %>
              <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span>Gestión de Vacaciones</span>
            <% end %>
          </div>
          
          <!-- Asistencia Section -->
          <div class="mt-6">
            <h3 class="px-6 py-2 text-xs font-bold uppercase tracking-wider" style="color: rgba(114, 47, 55, 0.7);">Asistencia</h3>
            
            <%= link_to admin_attendances_path, class: "flex items-center px-6 py-3 mx-2 my-1 rounded-lg transition-all duration-200 #{'text-white shadow-md font-semibold' if controller_name == 'attendances'} #{'text-gray-700 hover:bg-wine-primary/10 hover:text-wine-primary' unless controller_name == 'attendances'}", style: "#{'background-color: #722F37;' if controller_name == 'attendances'}" do %>
              <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Control de Asistencia</span>
            <% end %>
          </div>
          
          <!-- Reports Section -->
          <div class="mt-6">
            <h3 class="px-6 py-2 text-xs font-bold uppercase tracking-wider" style="color: rgba(114, 47, 55, 0.7);">Reportes</h3>
            
            <%= link_to "/admin/reports/new?type=vacation_request", class: "flex items-center px-6 py-3 mx-2 my-1 text-gray-700 rounded-lg transition-all duration-200 hover:bg-wine-primary/10 hover:text-wine-primary" do %>
              <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span>Solicitar Vacaciones</span>
            <% end %>
            
            <%= link_to admin_reports_path, class: "flex items-center px-6 py-3 mx-2 my-1 rounded-lg transition-all duration-200 #{'text-white shadow-md font-semibold' if controller_name == 'reports'} #{'text-gray-700 hover:bg-wine-primary/10 hover:text-wine-primary' unless controller_name == 'reports'}", style: "#{'background-color: #722F37;' if controller_name == 'reports'}" do %>
              <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <span>Todos los Reportes</span>
            <% end %>
          </div>

          <!-- System Administration Section -->
          <div class="mt-6">
            <h3 class="px-6 py-2 text-xs font-bold uppercase tracking-wider" style="color: rgba(114, 47, 55, 0.7);">Administración</h3>
            
            <%= link_to admin_employees_path, class: "flex items-center px-6 py-3 mx-2 my-1 rounded-lg transition-all duration-200 #{'text-white shadow-md font-semibold' if controller_name == 'employees'} #{'text-gray-700 hover:bg-wine-primary/10 hover:text-wine-primary' unless controller_name == 'employees'}", style: "#{'background-color: #722F37;' if controller_name == 'employees'}" do %>
              <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <span>Empleados</span>
            <% end %>
            
            <%= link_to admin_roles_path, class: "flex items-center px-6 py-3 mx-2 my-1 rounded-lg transition-all duration-200 #{'text-white shadow-md font-semibold' if controller_name == 'roles'} #{'text-gray-700 hover:bg-wine-primary/10 hover:text-wine-primary' unless controller_name == 'roles'}", style: "#{'background-color: #722F37;' if controller_name == 'roles'}" do %>
              <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
              <span>Roles y Permisos</span>
            <% end %>
          </div>
        </nav>

        <!-- Sidebar Footer -->
        <div class="p-6 border-t-2 flex flex-col" style="border-color: rgba(114, 47, 55, 0.2); background: linear-gradient(to right, rgba(114, 47, 55, 0.05), rgba(139, 58, 58, 0.05));">
          <div class="text-center">
            <p class="text-sm text-gray-600 mb-3 font-medium"><%= current_admin.email %></p>
            <%= link_to "Cerrar Sesión", destroy_admin_session_path, 
                data: { "turbo-method": :delete }, 
                class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white rounded-lg transition-colors shadow-md hover:shadow-lg hover:bg-wine-secondary", 
                style: "background-color: #722F37;" %>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 flex flex-col bg-gray-50">
        <!-- Header -->
        <header class="shadow-lg px-6 py-4 flex justify-between items-center" style="background: linear-gradient(to right, #722F37, #8B3A3A); border-bottom: 2px solid rgba(114, 47, 55, 0.3);">
          <h1 class="text-2xl font-bold text-white"><%= content_for(:page_title) || "Dashboard" %></h1>
          <div class="flex items-center space-x-3">
            <%= yield :header_actions %>
          </div>
        </header>

        <!-- Content Area -->
        <div class="flex-1 p-6">
          <!-- Flash Messages -->
          <% flash.each do |type, message| %>
            <div class="mb-6 p-4 rounded-lg <%= type == 'notice' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
              <div class="flex items-center">
                <span class="mr-2 text-lg">
                  <%= type == 'notice' ? '✅' : '❌' %>
                </span>
                <%= message %>
              </div>
            </div>
          <% end %>

          <!-- Page Content -->
          <%= yield %>
        </div>
      </main>
    </div>

    <!-- Mobile Sidebar Overlay (for future mobile support) -->
    <div class="fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden hidden" id="sidebar-overlay"></div>

  </body>
</html>