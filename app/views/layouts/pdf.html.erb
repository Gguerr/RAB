<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "RAB - Reporte" %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        line-height: 1.4;
        color: #333;
        margin: 0;
        padding: 20px;
      }
      
      .pdf-container {
        max-width: 100%;
        margin: 0 auto;
      }
      
      .pdf-header {
        text-align: center;
        margin-bottom: 30px;
        border-bottom: 2px solid #8B1538;
        padding-bottom: 20px;
      }
      
      .pdf-title {
        font-size: 24px;
        font-weight: bold;
        color: #8B1538;
        margin: 0 0 10px 0;
      }
      
      .header-info {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        color: #666;
      }
      
      .pdf-summary {
        margin-bottom: 30px;
        padding: 15px;
        background-color: #f8f9fa;
        border-left: 4px solid #8B1538;
      }
      
      .pdf-summary h2 {
        color: #8B1538;
        margin: 0 0 15px 0;
        font-size: 18px;
      }
      
      .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
      }
      
      .summary-item {
        font-size: 14px;
        color: #333;
      }
      
      .pdf-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
        font-size: 11px;
      }
      
      .pdf-table th {
        background-color: #8B1538;
        color: white;
        padding: 8px;
        text-align: left;
        font-weight: bold;
        border: 1px solid #8B1538;
      }
      
      .pdf-table td {
        padding: 6px 8px;
        border: 1px solid #ddd;
        vertical-align: top;
      }
      
      .pdf-table tr:nth-child(even) {
        background-color: #f9f9f9;
      }
      
      .pdf-table tr:nth-child(odd) {
        background-color: white;
      }
      
      .pdf-footer {
        margin-top: 40px;
        border-top: 1px solid #ddd;
        padding-top: 20px;
      }
      
      .footer-signatures {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
      }
      
      .signature-block {
        text-align: center;
        width: 200px;
      }
      
      .signature-line {
        height: 2px;
        background-color: #333;
        margin-bottom: 10px;
      }
      
      .signature-label {
        font-size: 12px;
        color: #666;
        margin: 5px 0;
      }
      
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin: 20px 0;
      }
      
      .stat-item {
        font-size: 14px;
        color: #333;
        padding: 10px;
        background-color: #f8f9fa;
        border-radius: 4px;
      }
      
      h1, h2, h3 {
        color: #8B1538;
        margin: 20px 0 10px 0;
      }
      
      h1 { font-size: 20px; }
      h2 { font-size: 18px; }
      h3 { font-size: 16px; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>