<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Control de Asistencia</h1>
    <p class="text-gray-600">Gestiona la asistencia diaria de los empleados</p>
  </div>

  <!-- Date Selector -->
  <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
    <h3 class="text-wine-primary text-xl font-bold mb-4">Seleccionar Fecha</h3>
    <%= form_with url: admin_attendances_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-4 items-end" do |form| %>
      <div class="flex-1">
        <%= form.label :date, "Fecha", class: "block text-gray-700 font-semibold mb-2" %>
        <%= form.date_field :date, value: @date, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-wine-primary focus:outline-none transition-colors" %>
      </div>
      <%= form.submit "Ver Asistencia", class: "bg-wine-primary text-white px-6 py-3 rounded-lg hover:bg-wine-secondary transition-colors font-semibold" %>
    <% end %>
  </div>

  <!-- Attendance List -->
  <div class="bg-white rounded-xl shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-wine-primary text-white">
      <h3 class="text-xl font-bold">Asistencia del <%= @date.strftime("%d/%m/%Y") %></h3>
    </div>
    
    <%= form_with url: bulk_update_admin_attendances_path, method: :patch, local: true, class: "p-6" do |form| %>
      <%= form.hidden_field :date, value: @date %>
      <%= form.hidden_field :action_type, value: "individual" %>
      
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 border-b">
              <th class="text-left py-4 px-4 font-semibold text-gray-700">Asistencia</th>
              <th class="text-left py-4 px-4 font-semibold text-gray-700">Cédula</th>
              <th class="text-left py-4 px-4 font-semibold text-gray-700">Nombres</th>
              <th class="text-left py-4 px-4 font-semibold text-gray-700">Apellidos</th>
              <th class="text-left py-4 px-4 font-semibold text-gray-700">Cargo</th>
              <th class="text-left py-4 px-4 font-semibold text-gray-700">Observaciones</th>
            </tr>
          </thead>
          <tbody>
            <% @attendances.each do |attendance| %>
              <tr class="border-b hover:bg-gray-50">
                <td class="py-4 px-4">
                  <div class="flex items-center gap-4">
                    <label class="flex items-center gap-1">
                      <%= radio_button_tag "attendances[#{attendance.employee.id}][present]",
                                           "1",
                                           attendance.present?,
                                           class: "w-5 h-5 text-wine-primary bg-gray-100 border-gray-300 rounded focus:ring-wine-primary focus:ring-2" %>
                      <span class="text-sm text-gray-700">Presente</span>
                    </label>
                    <label class="flex items-center gap-1">
                      <%= radio_button_tag "attendances[#{attendance.employee.id}][present]",
                                           "0",
                                           !attendance.present?,
                                           class: "w-5 h-5 text-wine-primary bg-gray-100 border-gray-300 rounded focus:ring-wine-primary focus:ring-2" %>
                      <span class="text-sm text-gray-700">Ausente</span>
                    </label>
                  </div>
                </td>
                <td class="py-4 px-4 font-medium text-gray-900">
                  <%= attendance.employee.identification_number %>
                </td>
                <td class="py-4 px-4 text-gray-900">
                  <%= attendance.employee.names %>
                </td>
                <td class="py-4 px-4 text-gray-900">
                  <%= attendance.employee.surnames %>
                </td>
                <td class="py-4 px-4 text-gray-600">
                  <%= attendance.employee.position %>
                </td>
                <td class="py-4 px-4">
                  <%= text_field_tag "attendances[#{attendance.employee.id}][notes]", 
                                     attendance.notes, 
                                     class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-wine-primary focus:outline-none text-sm",
                                     placeholder: "Observaciones" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <div class="mt-6 flex justify-end">
        <%= form.submit "💾 Guardar Cambios", 
                        class: "bg-wine-primary text-white px-8 py-3 rounded-lg hover:bg-wine-secondary transition-colors font-semibold" %>
      </div>
    <% end %>

    <!-- Acciones masivas: fuera del formulario principal para evitar formularios anidados -->
    <div class="mt-4 flex gap-3">
      <%= form_with url: bulk_update_admin_attendances_path, method: :patch, local: true, class: "inline" do |bulk_form| %>
        <%= bulk_form.hidden_field :date, value: @date %>
        <%= bulk_form.hidden_field :action_type, value: "mark_all_present" %>
        <%= bulk_form.submit "✅ Marcar Todos Presentes", 
                            class: "bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors font-semibold text-sm",
                            confirm: "¿Estás seguro de marcar a todos los empleados como presentes?" %>
      <% end %>

      <%= form_with url: bulk_update_admin_attendances_path, method: :patch, local: true, class: "inline" do |bulk_form| %>
        <%= bulk_form.hidden_field :date, value: @date %>
        <%= bulk_form.hidden_field :action_type, value: "mark_all_absent" %>
        <%= bulk_form.submit "❌ Marcar Todos Ausentes", 
                            class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors font-semibold text-sm",
                            confirm: "¿Estás seguro de marcar a todos los empleados como ausentes?" %>
      <% end %>
    </div>
  </div>

  <!-- Summary -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-green-50 border border-green-200 rounded-lg p-6">
      <div class="flex items-center">
        <div class="p-3 bg-green-100 rounded-full">
          <span class="text-green-600 text-xl">✅</span>
        </div>
        <div class="ml-4">
          <p class="text-green-800 font-semibold">Presentes</p>
          <p class="text-green-600 text-2xl font-bold"><%= @attendances.count { |a| a.present? } %></p>
        </div>
      </div>
    </div>
    
    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <div class="flex items-center">
        <div class="p-3 bg-red-100 rounded-full">
          <span class="text-red-600 text-xl">❌</span>
        </div>
        <div class="ml-4">
          <p class="text-red-800 font-semibold">Ausentes</p>
          <p class="text-red-600 text-2xl font-bold"><%= @attendances.count { |a| !a.present? } %></p>
        </div>
      </div>
    </div>
    
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <div class="flex items-center">
        <div class="p-3 bg-blue-100 rounded-full">
          <span class="text-blue-600 text-xl">📊</span>
        </div>
        <div class="ml-4">
          <p class="text-blue-800 font-semibold">Total Empleados</p>
          <p class="text-blue-600 text-2xl font-bold"><%= @attendances.count %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Report Actions -->
  <div class="mt-8 bg-white rounded-xl shadow-lg p-6">
    <h3 class="text-wine-primary text-xl font-bold mb-4">Reportes</h3>
    <style>
      /* Forzar colores visibles en los botones de reportes */
      .report-actions a { display: inline-flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 8px; font-weight: 600; text-decoration: none; }
      .report-actions a.purple { background-color: #7c3aed; color: #ffffff; }
      .report-actions a.red { background-color: #dc2626; color: #ffffff; }
      .report-actions a.blue { background-color: #2563eb; color: #ffffff; }
      .report-actions a.green { background-color: #16a34a; color: #ffffff; }
      .report-actions a:hover { filter: brightness(0.95); }
      .report-actions { display: flex; flex-direction: column; gap: 1rem; }
      @media (min-width: 640px) { .report-actions { flex-direction: row; } }
    </style>
    <div class="report-actions">
      <%= link_to physical_form_admin_attendances_path(date: @date), class: "purple" do %>
        📋 Planilla Física para Imprimir
      <% end %>
      
      <%= link_to report_admin_attendances_path(date: @date, format: :pdf), target: "_blank", class: "red" do %>
        🖨️ Reporte Diario PDF
      <% end %>
      
      <%= link_to monthly_report_admin_attendances_path(format: :pdf), class: "blue" do %>
        📅 Reporte Mensual
      <% end %>
      
      <%= link_to yearly_report_admin_attendances_path(format: :pdf), class: "green" do %>
        📊 Reporte Anual
      <% end %>
    </div>
  </div>
</div>


