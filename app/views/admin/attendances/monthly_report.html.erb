<div class="max-w-7xl mx-auto">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Reporte de Asistencia Mensual</h1>
    <p class="text-gray-600">Período: <%= Date::MONTHNAMES[@month] %> <%= @year %></p>
  </div>

  <!-- Month/Year Selector -->
  <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
    <h3 class="text-wine-primary text-xl font-bold mb-4">Seleccionar Período</h3>
    <%= form_with url: monthly_report_admin_attendances_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-4 items-end" do |form| %>
      <div class="flex-1">
        <%= form.label :month, "Mes", class: "block text-gray-700 font-semibold mb-2" %>
        <%= form.select :month, options_for_select((1..12).map { |m| [Date::MONTHNAMES[m], m] }, @month), {}, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-wine-primary focus:outline-none transition-colors" %>
      </div>
      <div class="flex-1">
        <%= form.label :year, "Año", class: "block text-gray-700 font-semibold mb-2" %>
        <%= form.select :year, options_for_select((Date.current.year - 5..Date.current.year + 1).map { |y| [y, y] }, @year), {}, class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-wine-primary focus:outline-none transition-colors" %>
      </div>
      <%= form.submit "Ver Reporte", class: "bg-wine-primary text-white px-6 py-3 rounded-lg hover:bg-wine-secondary transition-colors font-semibold" %>
    <% end %>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-green-100 rounded-full">
          <span class="text-green-600 text-xl">✅</span>
        </div>
        <div class="ml-4">
          <p class="text-gray-600 text-sm">Días Presentes</p>
          <p class="text-2xl font-bold text-gray-900"><%= @summary[:present_days] %></p>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-red-100 rounded-full">
          <span class="text-red-600 text-xl">❌</span>
        </div>
        <div class="ml-4">
          <p class="text-gray-600 text-sm">Días Ausentes</p>
          <p class="text-2xl font-bold text-gray-900"><%= @summary[:absent_days] %></p>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-blue-100 rounded-full">
          <span class="text-blue-600 text-xl">📅</span>
        </div>
        <div class="ml-4">
          <p class="text-gray-600 text-sm">Total Días</p>
          <p class="text-2xl font-bold text-gray-900"><%= @summary[:total_days] %></p>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 bg-purple-100 rounded-full">
          <span class="text-purple-600 text-xl">📊</span>
        </div>
        <div class="ml-4">
          <p class="text-gray-600 text-sm">% Asistencia</p>
          <p class="text-2xl font-bold text-gray-900"><%= @summary[:attendance_rate] %>%</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Monthly Calendar View -->
  <div class="bg-white rounded-xl shadow-lg overflow-hidden">
    <div class="px-6 py-4 bg-wine-primary text-white">
      <h3 class="text-xl font-bold">Calendario de Asistencia - <%= Date::MONTHNAMES[@month] %> <%= @year %></h3>
    </div>
    
    <div class="p-6">
      <div class="grid grid-cols-7 gap-2 mb-4">
        <div class="text-center font-semibold text-gray-700 py-2">Lun</div>
        <div class="text-center font-semibold text-gray-700 py-2">Mar</div>
        <div class="text-center font-semibold text-gray-700 py-2">Mié</div>
        <div class="text-center font-semibold text-gray-700 py-2">Jue</div>
        <div class="text-center font-semibold text-gray-700 py-2">Vie</div>
        <div class="text-center font-semibold text-gray-700 py-2">Sáb</div>
        <div class="text-center font-semibold text-gray-700 py-2">Dom</div>
      </div>
      
      <div class="grid grid-cols-7 gap-2">
        <% start_date = Date.new(@year, @month, 1).beginning_of_week %>
        <% end_date = Date.new(@year, @month, -1).end_of_week %>
        
        <% (start_date..end_date).each do |date| %>
          <% day_attendances = @attendances.select { |a| a.attendance_date == date } %>
          <% if date.month == @month %>
            <div class="aspect-square border border-gray-200 rounded-lg p-2 <%= 'bg-gray-100' if date < Date.current %>">
              <div class="text-sm font-medium text-gray-900"><%= date.day %></div>
              <% if day_attendances.any? %>
                <div class="mt-1">
                  <div class="text-xs text-green-600">✅ <%= day_attendances.count { |a| a.present? } %></div>
                  <div class="text-xs text-red-600">❌ <%= day_attendances.count { |a| !a.present? } %></div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="aspect-square border border-gray-100 rounded-lg p-2 bg-gray-50">
              <div class="text-sm text-gray-400"><%= date.day %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="mt-8 flex justify-between">
    <%= link_to admin_attendances_path, 
                class: "bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-colors font-semibold" do %>
      ← Volver a Asistencia
    <% end %>
    
    <%= link_to monthly_report_admin_attendances_path(year: @year, month: @month, format: :pdf), 
                class: "bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition-colors font-semibold flex items-center gap-2",
                target: "_blank" do %>
      🖨️ Imprimir PDF
    <% end %>
  </div>
</div>


