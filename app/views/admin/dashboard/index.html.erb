<% content_for :page_title, "Panel Administrativo" %>

<div class="space-y-8">
  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Employees Card -->
    <div class="group relative bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-slate-100">
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: linear-gradient(to bottom right, #eff6ff 0%, #eef2ff 100%);"></div>
      <div class="relative p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="p-3 rounded-xl shadow-lg" style="background: linear-gradient(to bottom right, #3b82f6 0%, #4f46e5 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <div class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-semibold">
            Total
          </div>
        </div>
        <h3 class="text-slate-600 text-sm font-medium mb-2">Empleados</h3>
        <p class="text-4xl font-bold mb-1" style="background: linear-gradient(to right, #2563eb 0%, #4f46e5 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;">
          <%= @employees_count %>
        </p>
        <p class="text-slate-500 text-sm">Total de empleados registrados</p>
      </div>
    </div>

    <!-- Payment Accounts Card -->
    <div class="group relative bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-slate-100">
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: linear-gradient(to bottom right, #f0fdf4 0%, #ecfdf5 100%);"></div>
      <div class="relative p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="p-3 rounded-xl shadow-lg" style="background: linear-gradient(to bottom right, #22c55e 0%, #059669 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
          </div>
          <div class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-semibold">
            Activas
          </div>
        </div>
        <h3 class="text-slate-600 text-sm font-medium mb-2">Cuentas de Pago</h3>
        <p class="text-4xl font-bold mb-1" style="background: linear-gradient(to right, #16a34a 0%, #059669 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;">
          <%= @payment_accounts_count %>
        </p>
        <p class="text-slate-500 text-sm">Cuentas registradas</p>
      </div>
    </div>

    <!-- Active Employees Card -->
    <div class="group relative bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-slate-100">
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: linear-gradient(to bottom right, rgba(114, 47, 55, 0.1) 0%, rgba(139, 58, 58, 0.1) 100%);"></div>
      <div class="relative p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="p-3 rounded-xl shadow-lg" style="background: linear-gradient(to bottom right, #722F37 0%, #8B3A3A 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <div class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: rgba(114, 47, 55, 0.1); color: #722F37;">
            Activos
          </div>
        </div>
        <h3 class="text-slate-600 text-sm font-medium mb-2">Empleados Activos</h3>
        <p class="text-4xl font-bold mb-1" style="background: linear-gradient(to right, #722F37 0%, #8B3A3A 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;">
          <%= Employee.active.count %>
        </p>
        <p class="text-slate-500 text-sm">Empleados en nómina</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6">
    <div class="flex items-center mb-6">
      <div class="p-2 rounded-lg mr-3" style="background: linear-gradient(to bottom right, #722F37 0%, #8B3A3A 100%);">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-slate-800">Acciones Rápidas</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <%= link_to admin_employees_path, class: "action-card action-card-blue group relative overflow-hidden rounded-xl p-6 border-2 transition-all duration-300", style: "background: linear-gradient(to bottom right, #f8fafc 0%, #ffffff 100%); border-color: #e2e8f0;" do %>
        <div class="absolute top-0 right-0 w-20 h-20 rounded-bl-full transform group-hover:scale-150 transition-transform duration-500" style="background: linear-gradient(to bottom right, rgba(59, 130, 246, 0.1) 0%, rgba(99, 102, 241, 0.1) 100%);"></div>
        <div class="relative">
          <div class="p-3 rounded-lg w-fit mb-4 group-hover:scale-110 transition-transform duration-300" style="background: linear-gradient(to bottom right, #3b82f6 0%, #4f46e5 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-slate-800 font-semibold text-lg mb-1 group-hover:text-wine-primary transition-colors">Gestionar Empleados</h3>
          <p class="text-slate-500 text-sm">Ver y administrar empleados</p>
        </div>
      <% end %>

      <%= link_to new_admin_employee_path, class: "action-card action-card-green group relative overflow-hidden rounded-xl p-6 border-2 transition-all duration-300", style: "background: linear-gradient(to bottom right, #f8fafc 0%, #ffffff 100%); border-color: #e2e8f0;" do %>
        <div class="absolute top-0 right-0 w-20 h-20 rounded-bl-full transform group-hover:scale-150 transition-transform duration-500" style="background: linear-gradient(to bottom right, rgba(34, 197, 94, 0.1) 0%, rgba(16, 185, 129, 0.1) 100%);"></div>
        <div class="relative">
          <div class="p-3 rounded-lg w-fit mb-4 group-hover:scale-110 transition-transform duration-300" style="background: linear-gradient(to bottom right, #22c55e 0%, #059669 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
          </div>
          <h3 class="text-slate-800 font-semibold text-lg mb-1 group-hover:text-green-600 transition-colors">Nuevo Empleado</h3>
          <p class="text-slate-500 text-sm">Registrar nuevo empleado</p>
        </div>
      <% end %>

      <%= link_to "/admin/reports/new?type=vacation_request", class: "action-card action-card-amber group relative overflow-hidden rounded-xl p-6 border-2 transition-all duration-300", style: "background: linear-gradient(to bottom right, #f8fafc 0%, #ffffff 100%); border-color: #e2e8f0;" do %>
        <div class="absolute top-0 right-0 w-20 h-20 rounded-bl-full transform group-hover:scale-150 transition-transform duration-500" style="background: linear-gradient(to bottom right, rgba(245, 158, 11, 0.1) 0%, rgba(249, 115, 22, 0.1) 100%);"></div>
        <div class="relative">
          <div class="p-3 rounded-lg w-fit mb-4 group-hover:scale-110 transition-transform duration-300" style="background: linear-gradient(to bottom right, #f59e0b 0%, #ea580c 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-slate-800 font-semibold text-lg mb-1 group-hover:text-amber-600 transition-colors">Solicitud de Vacaciones</h3>
          <p class="text-slate-500 text-sm">Crear nueva solicitud</p>
        </div>
      <% end %>

      <%= link_to admin_reports_path, class: "action-card action-card-purple group relative overflow-hidden rounded-xl p-6 border-2 transition-all duration-300", style: "background: linear-gradient(to bottom right, #f8fafc 0%, #ffffff 100%); border-color: #e2e8f0;" do %>
        <div class="absolute top-0 right-0 w-20 h-20 rounded-bl-full transform group-hover:scale-150 transition-transform duration-500" style="background: linear-gradient(to bottom right, rgba(168, 85, 247, 0.1) 0%, rgba(236, 72, 153, 0.1) 100%);"></div>
        <div class="relative">
          <div class="p-3 rounded-lg w-fit mb-4 group-hover:scale-110 transition-transform duration-300" style="background: linear-gradient(to bottom right, #a855f7 0%, #db2777 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-slate-800 font-semibold text-lg mb-1 group-hover:text-purple-600 transition-colors">Todos los Reportes</h3>
          <p class="text-slate-500 text-sm">Ver todos los reportes</p>
        </div>
      <% end %>

      <%= link_to admin_manual_path, class: "action-card action-card-indigo group relative overflow-hidden rounded-xl p-6 border-2 transition-all duration-300", style: "background: linear-gradient(to bottom right, #f8fafc 0%, #ffffff 100%); border-color: #e2e8f0;" do %>
        <div class="absolute top-0 right-0 w-20 h-20 rounded-bl-full transform group-hover:scale-150 transition-transform duration-500" style="background: linear-gradient(to bottom right, rgba(99, 102, 241, 0.1) 0%, rgba(79, 70, 229, 0.1) 100%);"></div>
        <div class="relative">
          <div class="p-3 rounded-lg w-fit mb-4 group-hover:scale-110 transition-transform duration-300" style="background: linear-gradient(to bottom right, #6366f1 0%, #4f46e5 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-slate-800 font-semibold text-lg mb-1 group-hover:text-indigo-600 transition-colors">Manual de Uso</h3>
          <p class="text-slate-500 text-sm">Descargar manual del sistema</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
